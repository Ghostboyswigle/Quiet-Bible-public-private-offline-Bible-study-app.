diff --git a/src/app/qb-host.ts b/src/app/qb-host.ts
new file mode 100644
index 0000000..97aca1f
--- /dev/null
+++ b/src/app/qb-host.ts
@@ -0,0 +1,26 @@
+import { toPassageOsisId, type Passage } from '../core/bible/passage.ts';
+import type { Versification } from '../core/bible/versification.ts';
+import type { TranslationId } from '../core/datasets/ids.ts';
+
+/**
+ * Quiet Bible: the map runs in a frame inside the Quiet Bible app and talks to it by message.
+ * `qb-map-close` closes the map; `qb-map-read` opens a passage in Quiet Bible's reader. The app
+ * checks that a message came from its own frame before acting on it.
+ */
+function tell(message: Record<string, string>): void {
+  if (window.parent !== window) {
+    window.parent.postMessage(message, '*');
+  }
+}
+
+export function closeMap(): void {
+  tell({ type: 'qb-map-close' });
+}
+
+export function readInQuietBible(
+  passage: Passage,
+  versification: Versification,
+  translation: TranslationId,
+): void {
+  tell({ type: 'qb-map-read', ref: toPassageOsisId(passage, versification), translation });
+}
